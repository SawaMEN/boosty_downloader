#!/usr/bin/env bash
set -euo pipefail
ETC=/etc/boosty-downloader
MODE_FILE="$ETC/mode"
PROJECT=/opt/boosty-downloader
mode() { if [[ -r "$MODE_FILE" ]]; then cat "$MODE_FILE"; else echo none; fi; }
need_root() { if [[ ${EUID:-$(id -u)} -ne 0 ]]; then echo 'Запустите через sudo.' >&2; exit 1; fi; }
docker_cmd() {
 local -a files=(-f "$PROJECT/compose.yaml")
 local mode="$(cat "$ETC/video-mode" 2>/dev/null || echo none)"
 case "$mode" in
 amd|intel) [[ -f "$PROJECT/compose.gpu-amd.yaml" ]] && files+=(-f "$PROJECT/compose.gpu-amd.yaml");;
 nvidia) [[ -f "$PROJECT/compose.gpu-nvidia.yaml" ]] && files+=(-f "$PROJECT/compose.gpu-nvidia.yaml");;
 esac
 docker compose --project-directory "$PROJECT" "${files[@]}" "$@"
}
operate() {
 local cmd="$1" kind; kind="$(mode)"
 case "$kind" in
 native)
   case "$cmd" in status) systemctl --no-pager status boosty-downloader.service || true;;logs) journalctl -u boosty-downloader.service -n 100 -f;;start|stop|restart) systemctl "$cmd" boosty-downloader.service;;esac;;
 docker)
   case "$cmd" in status) docker_cmd ps;;logs) docker_cmd logs --tail 100 -f;;start) docker_cmd up -d;;stop) docker_cmd stop;;restart) docker_cmd restart;;esac;;
 *) echo 'Boosty Downloader ещё не установлен.';return 1;;
 esac
}
reset_password() {
 command -v openssl >/dev/null || { echo 'Требуется openssl.' >&2;return 1; }
 [[ -r "$ETC/environment" ]] || { echo 'Панель не установлена.' >&2;return 1; }
 local password tmp previous
 password="$(openssl rand -hex 18)"
 previous="$(mode)"
 case "$previous" in
 native)
   systemctl stop boosty-downloader.service
   if ! (set -a; source "$ETC/environment"; set +a; printf '%s' "$password" | runuser -u boosty-downloader -- /usr/local/boosty-downloader/boosty-downloader reset-admin-password);then
     systemctl start boosty-downloader.service || true
     echo 'Ошибка смены пароля' >&2;return 1
   fi
   systemctl start boosty-downloader.service;;
 docker)
   docker_cmd stop
   if ! (printf '%s' "$password" | docker_cmd run --rm -T --no-deps boosty-downloader reset-admin-password);then
     docker_cmd up -d || true
     echo 'Ошибка смены пароля' >&2;return 1
   fi
   docker_cmd up -d;;
 *) echo 'Установка не найдена.' >&2;return 1;;
 esac
 tmp="$(mktemp "$ETC/.environment-XXXXXXXX")"
 sed "s/^BD_ADMIN_PASSWORD=.*/BD_ADMIN_PASSWORD=\"$password\"/" "$ETC/environment" > "$tmp"
 chown root:boosty-downloader "$tmp";chmod 0640 "$tmp";mv -f "$tmp" "$ETC/environment"
 echo "Новый пароль администратора: $password"
 echo 'Все прежние сессии администратора завершены.'
}

need_root
case "${1:-menu}" in
 status|logs|start|stop|restart) operate "$1";;
 reset-password|credentials) reset_password;;
 uninstall)
   echo 'Остановка и удаление Boosty Downloader (без удаления архива по умолчанию)...'
   systemctl disable --now boosty-downloader.service boosty-downloader-cert-renew.timer boosty-downloader-update.timer >/dev/null 2>&1 || true
   if command -v docker >/dev/null && [[ -f "$PROJECT/compose.yaml" ]]; then docker_cmd down || true; fi
   rm -f /etc/systemd/system/boosty-downloader.service /etc/systemd/system/boosty-downloader-cert-renew.service /etc/systemd/system/boosty-downloader-cert-renew.timer /usr/local/bin/bdy-cert-renew /usr/local/bin/bdy-auto-update /etc/systemd/system/boosty-downloader-update.service /etc/systemd/system/boosty-downloader-update.timer
   systemctl daemon-reload >/dev/null 2>&1 || true
   rm -rf -- /usr/local/boosty-downloader "$PROJECT"
   rm -f -- "$MODE_FILE" /usr/local/bin/bdy /usr/local/bin/boosty-dbcheck
   if [[ "${2:-}" == --purge ]]; then
      read -r -p 'Безвозвратно удалить токены, архивы и настройки? Напишите DELETE: ' confirmation </dev/tty
      if [[ "$confirmation" == DELETE ]]; then rm -rf -- /var/lib/boosty-downloader /etc/boosty-downloader; echo 'Данные удалены.';else echo 'Данные сохранены.';fi
   fi
   echo 'Удалено. Данные и сертификаты сохранены, если не указан --purge.';;
 update)
   if [[ -x /usr/local/bin/bdy-auto-update ]]; then /usr/local/bin/bdy-auto-update "${2:---force}";
   else echo "Служба обновлений не установлена. Повторите sudo bash install.sh." >&2; exit 1; fi;;
 rollback)
   if [[ -x /usr/local/bin/bdy-auto-update ]]; then /usr/local/bin/bdy-auto-update --rollback;
   else echo "Резервная версия отсутствует." >&2; exit 1; fi;;
 menu)
    echo 'Boosty Downloader — управление'
    echo '1) Статус  2) Запуск  3) Остановка  4) Перезапуск'
    echo '5) Логи    6) Удалить   7) Сбросить пароль  8) Обновления  9) Откат  0) Выход'
    read -r -p 'Выбор: ' answer </dev/tty
    case "$answer" in 1) operate status;;2) operate start;;3) operate stop;;4) operate restart;;5) operate logs;;6) "$0" uninstall;;7) reset_password;;8) "$0" update;;9) "$0" rollback;;0) exit 0;;*) echo 'Неизвестная команда';exit 1;;esac;;
 *) echo 'Команды: status, start, stop, restart, logs, reset-password, update [--apply], rollback, uninstall [--purge]';exit 2;;
esac
